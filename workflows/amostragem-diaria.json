      "id": "aa1dfddc-ed0d-51c8-ae15-29d54eb86d49",
      "name": "Busca Chamadas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1100,
        400
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Escolhe as ligações do dia desta fila e monta o(s) lote(s) para a API de avaliação.\n//   1. Elegíveis: receptivas, atendidas, acima da duração mínima e com gravação.\n//   2. Detratores (e neutros, se ligado) entram sempre.\n//   3. As demais são sorteadas até o teto de minutos da fila.\nconst cfg  = $('Config').first().json;\nconst fila = $('Loop Filas').first().json;\n\nconst txt = (v) => String(v ?? '').trim();\nconst num = (v) => (/^\\d+$/.test(txt(v)) ? Number(txt(v)) : null);\nconst seg = (x) => Number(x.c.call_duration) || 0;\nconst base = { enviar: false, filaId: fila.filaId, fila: fila.label, dia: fila.dia, criteriaId: txt(cfg.criteriaId) };\n\nif (!/^[1-9]\\d*$/.test(base.criteriaId)) return [{ json: { ...base, motivo: 'criteriaId não configurado' } }];\n\n// Ligações deste dia e desta fila que a API já aceitou (aba LOTES): não vão de novo.\n// Reprocessar o dia manda só o que faltou, sem análise nem cobrança em dobro.\nconst jaEnviadas = new Set($('Lê Lotes').all().map((i) => i.json)\n  .filter((r) => txt(r.fila_id) === txt(fila.filaId) && txt(r.dia) === fila.dia\n    && ['ok', 'divergente'].includes(txt(r.status)))\n  .flatMap((r) => txt(r.call_ids).split(',').filter(Boolean)));\n\nconst chamadas = $input.all().flatMap((i) => (i.json.data && i.json.data.calls) || []);\n\nconst elegiveis = chamadas.filter((c) =>\n  txt(c.queue_id) === txt(fila.filaId)\n  && txt(c.direction) === 'inbound'\n  && txt(c.time_connect)\n  && Number(c.call_duration || 0) > Number(cfg.duracaoMinimaSeg)\n  && txt(c.recording_uuid));\n\n// Na transferência, a mesma gravação aparece em duas pernas. Fica a última: é nela que cai a\n// pesquisa, respondida depois que o último agente sai da linha.\nconst porGravacao = new Map();\n[...elegiveis].sort((a, b) => txt(a.time_connect).localeCompare(txt(b.time_connect)))\n  .forEach((c) => porGravacao.set(txt(c.recording_uuid), c));\nconst ligacoes = [...porGravacao.values()];\n\nconst npsMax = Number(cfg.npsDetratorAte);\nconst classe = (c) => {\n  const n = num(c.nps);\n  if ((n !== null && n <= npsMax) || (txt(cfg.csatDetrator) && txt(c.csat) === txt(cfg.csatDetrator))) return 'detrator';\n  if (cfg.incluirNeutros && n !== null && n > npsMax && n <= 8) return 'neutro';\n  return 'sorteio';\n};\n\n// Telefone com DDI. Um telefone vazio (ou \"0\") faz a API recusar o LOTE INTEIRO,\n// então a ligação sem telefone válido fica de fora e entra na contagem semTelefone.\nconst fone = (c) => {\n  let f = txt(c.caller_number).replace(/\\D/g, '').replace(/^0+/, '');\n  if (f.length === 10 || f.length === 11) f = txt(cfg.ddi) + f;\n  return new RegExp(`^${txt(cfg.ddi)}\\\\d{10,11}$`).test(f) ? f : '';\n};\n\n// Sorteio estável: cada ligação recebe uma nota pseudoaleatória tirada de semente + dia + fila + id.\n// Reprocessar o dia sorteia as mesmas ligações, e uma ligação a mais no relatório não mexe na ordem\n// das outras.\nconst nota = (id) => {\n  let h = 0x811c9dc5;                                        // FNV-1a, 32 bits\n  for (const ch of `${cfg.semente}|${fila.dia}|${fila.filaId}|${id}`) {\n    h ^= ch.codePointAt(0);\n    h = Math.imul(h, 0x01000193);\n  }\n  h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b);               // mistura final do murmur3\n  h ^= h >>> 13; h = Math.imul(h, 0xc2b2ae35);\n  return (h ^ (h >>> 16)) >>> 0;\n};\n\nconst candidatas = ligacoes.map((c) => ({ c, classe: classe(c), fone: fone(c) }));\nconst comFone = candidatas.filter((x) => x.fone);\nconst ordemClasse = { detrator: 0, neutro: 1 };\nconst amostra = comFone.filter((x) => x.classe !== 'sorteio')\n  .sort((a, b) => ordemClasse[a.classe] - ordemClasse[b.classe]);\n\n// Os detratores entram mesmo que passem do teto, e contam nele.\nconst tetoSeg = (Math.max(0, Number(cfg.minutosDia) || 0) * 60) / Object.keys(cfg.filas).length;\nlet usadoSeg = amostra.reduce((s, x) => s + seg(x), 0);\nif (tetoSeg > 0) {\n  const resto = comFone.filter((x) => x.classe === 'sorteio')\n    .map((x) => ({ ...x, nota: nota(txt(x.c.call_id)) }))\n    .sort((a, b) => a.nota - b.nota || txt(a.c.call_id).localeCompare(txt(b.c.call_id)));\n  // Para na primeira que não cabe. Pular para a seguinte favoreceria as ligações curtas.\n  for (const x of resto) {\n    if (usadoSeg + seg(x) > tetoSeg) break;\n    amostra.push(x);\n    usadoSeg += seg(x);\n  }\n}\n\nconst novas = amostra.filter((x) => !jaEnviadas.has(txt(x.c.call_id)));\nconst resumo = {\n  elegiveis: ligacoes.length,\n  comPesquisa: ligacoes.filter((c) => txt(c.nps) || txt(c.csat)).length,\n  semTelefone: candidatas.length - comFone.length,\n  jaEnviadas: amostra.length - novas.length,\n  minutosDia: Math.round(usadoSeg / 60),\n};\n\nif (!novas.length) {\n  const motivo = amostra.length ? 'dia já enviado'\n    : tetoSeg > 0 ? 'nenhuma ligação elegível' : 'nenhum detrator no dia';\n  return [{ json: { ...base, ...resumo, motivo } }];\n}\n\nconst LOTE = Math.max(1, Number(cfg.loteMax) || 35);\nconst [ano, mes, d] = fila.dia.split('-');\nconst partes = Math.ceil(novas.length / LOTE);\nconst out = [];\n\nfor (let p = 0; p < partes; p++) {\n  const parte = novas.slice(p * LOTE, (p + 1) * LOTE);\n  const payload = {\n    batch_name: `[${fila.label}] ${tetoSeg > 0 ? 'Amostra' : 'Detratores'} ${d}/${mes}/${ano}`\n      + (partes > 1 ? ` (${p + 1}/${partes})` : ''),\n    criteria_id: base.criteriaId,\n  };\n  // Campos indexados a partir de 0, sem buraco. O link do áudio leva só o marcador do token:\n  // o Envia Lote troca pelo token de verdade na hora do envio.\n  parte.forEach(({ c, classe: cl, fone: f }, i) => {\n    payload[`phone_number_${i}`] = f;\n    payload[`agent_${i}`]        = txt(c.agent_name) || txt(c.agent_login) || 'nao_informado';\n    payload[`campaign_${i}`]     = fila.label;\n    payload[`audioUrls_${i}`]    = `${cfg.telefoniaUrl}/api/v1/recordings/${encodeURIComponent(txt(c.recording_uuid))}?token=__TOKEN_GRAVACAO__`;\n    payload[`metadata_${i}`]     = JSON.stringify({          // chave de volta para a telefonia\n      id_chamada:   txt(c.call_id),\n      protocolo:    txt(c.protocol_number),\n      gravacao:     txt(c.recording_uuid),\n      fila:         fila.label,\n      agente_login: txt(c.agent_login),\n      atendimento:  txt(c.time_connect),\n      duracao_s:    seg({ c }),\n      amostra:      cl,                                      // detrator | neutro | sorteio\n      nps:          txt(c.nps),\n      csat:         txt(c.csat),\n    });\n  });\n  const conta = (cl) => parte.filter((x) => x.classe === cl).length;\n  out.push({ json: {\n    ...base, ...resumo,\n    enviar: true,\n    motivo: 'amostra do dia',\n    itens: parte.length,\n    detratores: conta('detrator'),\n    neutros: conta('neutro'),\n    sorteadas: conta('sorteio'),\n    minutos: Math.round(parte.reduce((s, x) => s + seg(x), 0) / 60),\n    call_ids: parte.map((x) => txt(x.c.call_id)).join(','),\n    payload,\n  } });\n}\nreturn out;\n"
      },
      "id": "6d609343-fe3f-5231-8323-253b0cb143a0",
      "name": "Seleciona Amostra",
      "type": "n8n-nodes-base.code",
