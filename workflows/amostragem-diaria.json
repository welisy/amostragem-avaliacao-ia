    {
      "parameters": {
        "jsCode": "// ===== Configuração =====\n// Tudo que muda de uma operação para outra fica aqui.\nconst config = {\n  telefoniaUrl: 'https://telefonia.exemplo.com',   // relatório de chamadas e link das gravações\n  planilhaId: 'COLE_O_ID_DA_PLANILHA',             // planilha com a aba LOTES\n  fuso: 'America/Sao_Paulo',\n\n  criteriaId: '0',                 // critério na API de avaliação (sai do scripts/criar_criterio.py)\n  filas: {                         // id da fila na telefonia -> nome que aparece no painel\n    '4': { label: 'Atendimento' },\n    '7': { label: 'Retenção' },\n  },\n\n  // ----- amostra\n  npsDetratorAte: 6,               // NPS até aqui = detrator\n  csatDetrator: 'Insatisfeito',    // ...ou esta resposta no CSAT\n  incluirNeutros: false,           // NPS entre npsDetratorAte + 1 e 8\n  minutosDia: 900,                 // teto de áudio por dia, somando as filas (0 = só detratores)\n  semente: 'troque-esta-frase',    // muda o sorteio. Mesma semente e mesmo dia = mesmas ligações\n\n  // ----- elegibilidade e envio\n  duracaoMinimaSeg: 30,\n  ddi: '55',\n  loteMax: 35,\n\n  // Reprocessar um dia: 'aaaa-mm-dd'. Vazio = hoje.\n  dataReprocesso: '',\n\n  // A API de avaliação baixa o áudio pelo link da gravação, que leva este token na URL.\n  // O n8n não deixa ler credencial dentro de expressão, por isso ele fica aqui. Só entra no\n  // corpo da requisição no nó Envia Lote: fica fora da planilha e da saída do Seleciona Amostra.\n  tokenGravacao: 'COLE_O_TOKEN_DE_GRAVACAO',\n};\n\nreturn [{ json: config }];\n"
      },
