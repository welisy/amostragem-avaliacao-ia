      "id": "c0584b9c-b93a-5718-b7f4-242f9c5b02c2",
      "name": "Lê Lotes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        440,
        300
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Uma volta do loop por fila. Dia = hoje no fuso da operação, ou o dataReprocesso.\n// Roda às 21h, depois do fim do expediente: a pesquisa entra no relatório minutos após a ligação.\nconst cfg = $('Config').first().json;\nconst hoje = new Intl.DateTimeFormat('en-CA', {\n  timeZone: cfg.fuso, year: 'numeric', month: '2-digit', day: '2-digit',\n}).format(new Date());\nconst dia = String(cfg.dataReprocesso || '').trim() || hoje;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(dia)) throw new Error(`dataReprocesso inválida: \"${dia}\" (use aaaa-mm-dd)`);\n\nreturn Object.entries(cfg.filas).map(([filaId, f]) => ({ json: { filaId, dia, ...f } }));\n"
      },
      "id": "2b58a852-1f78-527d-9916-7005a9e13e40",
      "name": "Lista Filas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "760d9db8-d5da-5dce-90f2-8c3e57a8b3fc",
      "name": "Loop Filas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
